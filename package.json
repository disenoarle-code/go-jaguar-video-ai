{
  "name": "editor-gojaguar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gojaguar/app",
    "test": "vitest run",
    "check": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/app",
    "instalar": "node scripts/instalar.mjs",
    "py": "node scripts/py.mjs",
    "vigilar": "node scripts/vigilar-solicitudes.mjs",
    "solicitud": "node scripts/solicitud.mjs",
    "progreso": "node scripts/progreso.mjs",
    "nota-estilo": "node scripts/nota-estilo.mjs",
    "aprender": "python3 scripts/aprender.py"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.2.0",
    "@types/node": "^26.6.6"
  }
}
